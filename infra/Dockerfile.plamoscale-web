# Multi-stage Dockerfile for @gunpla/plamoscale-web
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root workspace configs
COPY package.json package-lock.json tsconfig.base.json ./

# Copy packages and plamoscale-web app
COPY packages/shared/package.json ./packages/shared/
COPY apps/plamoscale-web/package.json ./apps/plamoscale-web/

# Install all dependencies across workspaces
RUN npm ci

# Copy source files
COPY packages/shared ./packages/shared
COPY apps/plamoscale-web ./apps/plamoscale-web

# Build shared package then plamoscale-web
RUN npm run build --workspace=@gunpla/shared
RUN npm run build --workspace=@gunpla/plamoscale-web

# Production Runner
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/plamoscale-web/package.json ./apps/plamoscale-web/

# Install production dependencies only
RUN npm ci --omit=dev

# Copy compiled artifacts from builder
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/plamoscale-web/dist ./apps/plamoscale-web/dist

EXPOSE 3000

CMD ["node", "apps/plamoscale-web/dist/server.js"]
