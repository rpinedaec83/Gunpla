# Multi-stage Dockerfile for @gunpla/gunplajunkies-web
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root workspace configs
COPY package.json package-lock.json tsconfig.base.json ./

# Copy packages and gunplajunkies-web app
COPY packages/shared/package.json ./packages/shared/
COPY apps/gunplajunkies-web/package.json ./apps/gunplajunkies-web/

# Install all dependencies across workspaces
RUN npm ci

# Copy source files
COPY packages/shared ./packages/shared
COPY apps/gunplajunkies-web ./apps/gunplajunkies-web

# Build shared package then gunplajunkies-web
RUN npm run build --workspace=@gunpla/shared
RUN npm run build --workspace=@gunpla/gunplajunkies-web

# Production Runner
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/gunplajunkies-web/package.json ./apps/gunplajunkies-web/

# Install production dependencies only
RUN npm ci --omit=dev

# Copy compiled artifacts from builder
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/gunplajunkies-web/dist ./apps/gunplajunkies-web/dist

EXPOSE 3001

CMD ["node", "apps/gunplajunkies-web/dist/server.js"]
